DISCORD_TOKEN=your_bot_token_here
GUILD_ID=0
OWNER_ID=0
EVENT_CHANNEL_ID=0
WELCOME_CHANNEL_ID=0
RULES_CHANNEL_ID=0
SERVER_TZ_OFFSET=-2
# Optional: Paste your MongoDB Atlas URI to store all data in the cloud (recommended on FadeHost/Railway)
# Leave blank to use local SQLite (haven_bot.db) automatically
MONGO_URI=
MONGO_DB_NAME=haven_bot
# Set to false after first sync if you prefer manual .sync via Owner DM
AUTO_SYNC_COMMANDS=true
